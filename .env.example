# ---------------------------------------------------------------
# IG SEARCH - variables de entorno
# Copia este fichero a .env.local y rellena los valores.
# NUNCA subas .env.local al repositorio.
# ---------------------------------------------------------------

# Base de datos PostgreSQL
DATABASE_URL=postgresql://igsearch:igsearch@localhost:5432/igsearch

# --- Meta / Instagram Graph API -------------------------------
# Token de larga duracion de la pagina de Facebook vinculada al IG de la agencia
META_ACCESS_TOKEN=
# ID de la cuenta de Instagram Business (se obtiene con: npm run radar -- --whoami)
META_IG_USER_ID=
META_API_VERSION=v23.0

# --- Google Places API (New) ----------------------------------
GOOGLE_PLACES_API_KEY=

# --- PageSpeed Insights API (gratuita, misma consola de Google)-
GOOGLE_PAGESPEED_API_KEY=

# --- Seguridad del endpoint de tareas programadas -------------
# Cadena aleatoria. El cron de Coolify llama a /api/radar con esta cabecera.
RADAR_CRON_SECRET=

# --- Acceso al panel ------------------------------------------
# Contrasena unica para entrar al panel (Basic Auth)
PANEL_PASSWORD=
