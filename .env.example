# ---------------------------------------------------------------
# IG SEARCH - variables de entorno
# Copia este fichero a .env.local y rellena los valores.
# NUNCA subas .env.local al repositorio ni compartas su contenido.
# ---------------------------------------------------------------

# --- Base de datos --------------------------------------------
# SQLite: un unico fichero, sin servidor ni proveedor.
# En produccion apunta a una ruta FUERA de la carpeta de despliegue
# para que no se borre al actualizar la aplicacion.
# Ejemplo en Hostinger: /home/USUARIO/datos/igsearch.db
DATABASE_FILE=

# --- Meta / Instagram Graph API -------------------------------
# Solo hacen falta para la parte de Instagram. El radar de webs
# funciona sin ellas.
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=
META_IG_USER_ID=
META_API_VERSION=v23.0

# --- Seguridad ------------------------------------------------
# Cadena aleatoria. El cron llama a /api/radar con esta cabecera.
RADAR_CRON_SECRET=
