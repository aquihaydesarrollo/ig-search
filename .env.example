# ---------------------------------------------------------------
# IG SEARCH - variables de entorno
# Copia este fichero a .env.local y rellena los valores.
# NUNCA subas .env.local al repositorio ni compartas su contenido.
# ---------------------------------------------------------------

# --- Base de datos --------------------------------------------
# SQLite: un unico fichero, sin servidor ni proveedor.
# Por defecto se guarda en ~/.ig-search/igsearch.db, es decir la carpeta
# personal del usuario, que sobrevive a los despliegues. Solo hay que
# rellenar esto si quieres otra ruta.
DATABASE_FILE=

# --- Meta / Instagram Graph API -------------------------------
# Solo hacen falta para la parte de Instagram. El radar de webs
# funciona sin ellas.
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=
META_IG_USER_ID=
META_API_VERSION=v23.0

# --- Seguridad ------------------------------------------------
# Contrasena para entrar al panel. Si se deja vacia, el panel queda
# ABIERTO a cualquiera que conozca la direccion.
PANEL_PASSWORD=

# Cadena aleatoria. La tarea programada llama a /api/radar con esta cabecera.
RADAR_CRON_SECRET=
